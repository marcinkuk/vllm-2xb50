+        if bytes_to_free <= 0:
+            return [], 0
+        evicted = []
+        freed = 0
+        candidates = []
+        available = 0
+        for path, size in self._entries.items():
+            if path in protected or path in self._protected_paths:
+                continue
+            candidates.append((path, size))
+            available += size
+            if available >= bytes_to_free:
+                break
+        if available < bytes_to_free:
+            return [], 0
+        for path, size in candidates:
+            if freed >= bytes_to_free:
