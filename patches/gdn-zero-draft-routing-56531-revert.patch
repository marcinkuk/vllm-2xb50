Subject: [XPU][Qwen3.5-MTP] Restore 63-like GDN zero-draft row routing (revert #56531 steady-state)
#
# ROOT CAUSE of the build-64 (base 32feecd91) MTP acceptance collapse
# (~0.8-3.4% vs ~50-69% on build-63 c32495d58; SAME checkpoint, SAME command,
# TP=2, n=3): upstream #56531 (0eac152707) re-routed GDN recurrent-state rows
# so that EVERY non-prefill decode row -- including zero-draft rows -- is
# forced through the speculative path, in three places:
#   1. gdn_attn.py build(): the all-zero-draft guard lost its
#      "or sum(drafts[mask]) == 0" clause.
#   2. mamba_hybrid.py: the spec-row mask dropped the
#      "num_draft_tokens_per_req > 0" requirement.
#   3. gpu_model_runner.py: use_spec_decode flipped from
#      "len(scheduled_spec_decode_tokens) > 0" to
#      "speculative_config is not None" (2 sites) and a zero_draft_decode_mask
#      stamps zero-draft decode rows with num_decode_draft_tokens = 0
#      (a spec-row sentinel).
#
# On this GDN hybrid + MTP drafter, a single-request verify step whose only
# non-prefill row is a zero-draft decode is mis-routed through the spec path,
# reads its recurrent state at the wrong slot, and the first drafted token is
# effectively random; the remaining MTP steps (which condition on it) are all
# rejected -> the position-1 collapse in the 64 logs. Build 63 had none of
# this, so its drafts accepted at 50-69%.
#
# This patch reverts ONLY those three steady-state hunks to the exact
# c32495d58 (build 63) form. It deliberately does NOT touch:
#   - the CUDAGraph CAPTURE path: [11] gdn-capture-gate-56531
#     (build_for_cudagraph_capture -> build(..., None)) is a separate hunk in
#     a different method of gdn_attn.py and stays intact, preserving the
#     #60379 oneCCL-in-capture-window fix;
#   - #58463 (fused multi-step decode metadata) and the AITER/FlashInfer
#     prefill-checkpoint machinery, neither of which runs in this XPU
#     steady-state decode path.
# It is a targeted revert, not a clean "git revert 0eac152707" (that fails:
# mamba_hybrid.py and the prefill-tail tests drifted after #56531). Re-hunk
# if these three files drift again upstream.
diff --git a/vllm/v1/attention/backends/gdn_attn.py b/vllm/v1/attention/backends/gdn_attn.py
index 6b99ec545..6213f60e4 100644
--- a/vllm/v1/attention/backends/gdn_attn.py
+++ b/vllm/v1/attention/backends/gdn_attn.py
@@ -342,10 +342,16 @@ class GDNAttentionMetadataBuilder(AttentionMetadataBuilder[GDNAttentionMetadata]
         else:
             spec_sequence_masks_cpu = num_decode_draft_tokens_cpu >= 0
             num_spec_decodes = spec_sequence_masks_cpu.sum().item()
-            # A batch whose rows all drafted nothing still has to run the
-            # speculative path: that is the only path that applies each row's
-            # accepted-token offset to the recurrent state.
-            if num_spec_decodes == 0:
+            # 63-like (marcinkuk/vllm-2xb50, revert #56531 steady-state): a
+            # batch whose spec rows all drafted zero still runs the normal
+            # path. #56531 removed the draft-sum clause; on this GDN hybrid +
+            # MTP drafter that forces a zero-draft decode row onto the spec
+            # path and collapses position-1 acceptance.
+            if (
+                num_spec_decodes == 0
+                or num_decode_draft_tokens_cpu[spec_sequence_masks_cpu].sum().item()
+                == 0
+            ):
                 num_spec_decodes = 0
                 spec_sequence_masks = None
                 spec_sequence_masks_cpu = None
diff --git a/vllm/v1/worker/gpu/model_states/mamba_hybrid.py b/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
index 94c57c196..f12fed4b8 100644
--- a/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
+++ b/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
@@ -279,26 +279,17 @@ class MambaHybridModelState(DefaultModelState):
             ]
 
             # GDN uses >= 0 to select spec-decode rows, so non-decode rows
-            # need the -1 sentinel. Decode rows without drafts stay spec rows:
-            # only that path applies the previous step's accepted offset.
+            # need the -1 sentinel rather than a raw zero draft count.
+            # 63-like (revert #56531 steady-state): only decode rows that
+            # actually have draft tokens take the spec path; zero-draft
+            # decode rows stay normal decode.
             num_decode_draft_tokens_np = np.full(num_reqs, -1, dtype=np.int32)
             num_draft_tokens_per_req = input_batch.num_draft_tokens_per_req
-            if num_draft_tokens_per_req is None:
-                num_draft_tokens_per_req = np.zeros(input_batch.num_reqs, np.int32)
-            # Test request state, not num_scheduled_tokens == draft_count+1:
-            # adaptive rewrites num_scheduled_tokens to an even split, so that
-            # equality rarely holds and would demote every verify row to decode.
-            is_decode = (
-                ~is_prefilling_np
-                & (input_batch.num_scheduled_tokens > 0)
-                & (
-                    input_batch.num_scheduled_tokens
-                    <= self.vllm_config.num_speculative_tokens + 1
+            if num_draft_tokens_per_req is not None:
+                spec_decode_mask = (num_draft_tokens_per_req > 0) & ~is_prefilling_np
+                num_decode_draft_tokens_np[: input_batch.num_reqs] = np.where(
+                    spec_decode_mask, num_draft_tokens_per_req, -1
                 )
-            )
-            num_decode_draft_tokens_np[: input_batch.num_reqs] = np.where(
-                is_decode, num_draft_tokens_per_req, -1
-            )
             num_decode_draft_tokens_cpu = torch.from_numpy(num_decode_draft_tokens_np)
 
         if self._align_mode:
